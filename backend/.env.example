# ─────────────────────────────────────────────────────────────────────────
# .env.example — committed to git, safe defaults for LOCAL DEVELOPMENT.
#
# How to use:
#
#   1. cp .env.example .env
#   2. (Optional) update DB_SOURCE if your local Postgres uses different
#      credentials than the docker-compose defaults.
#   3. Run `make demo` (or docker compose up + make seed + make run)
#
# The backend boots in DRY-RUN mode by default. No real Stellar wallet,
# no API keys, no facilitator account needed. The full agent flow works
# (init, sponsor, sep10, paid calls) using stub payments locally.
#
# To go LIVE (real USDC settlement on Stellar testnet via OZ facilitator):
#
#   1. Generate a fresh treasury wallet:    make gen-wallet
#   2. Fund it with ~5 XLM and some USDC from a CEX
#   3. Get an OZ facilitator API key:       curl https://channels.openzeppelin.com/gen
#   4. Replace the empty values below (X402_TREASURY_*, X402_FACILITATOR_*)
#   5. Set X402_DRY_RUN=false
#   6. Restart the backend
#
# DEPLOY.md has the full production setup runbook for a fresh Ubuntu VPS.
# ─────────────────────────────────────────────────────────────────────────

# ─── Environment ────────────────────────────────────────
ENV=development
SERVER_ADDRESS=0.0.0.0:8086
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# ─── Database ───────────────────────────────────────────
# Default values match the docker-compose.yml. For self-hosted Postgres,
# update DB_SOURCE accordingly.
DB_SOURCE=postgres://stellarflow:stellarflow@localhost:5432/stellarflow_x402?sslmode=disable
POSTGRES_PASSWORD=stellarflow

# ─── Redis ──────────────────────────────────────────────
REDIS_ADDR=localhost:6379

# ─── Paseto auth tokens ─────────────────────────────────
# DEVELOPMENT KEY — never use in production. Generate a fresh one for any
# public-facing deployment with: openssl rand -hex 16
# Must be exactly 32 ASCII characters.
TOKEN_SYMMETRIC_KEY=devkey32charssomethingrand0m0ka1
ACCESS_TOKEN_DURATION=24h
REFRESH_TOKEN_DURATION=720h

# ─── SEP-10 wallet sign-in ──────────────────────────────
# DEVELOPMENT KEYPAIR — fresh, unfunded, for signing local dev SEP-10
# challenges only. NEVER hold value on this address. For production,
# generate a fresh keypair with `make gen-wallet` and put the secret
# in your VPS .env (it doesn't need any XLM funding either — only signs
# challenge transactions).
SEP10_SERVER_SECRET_KEY=SC3Y2SNSKF6U6JL7PRMZWYMUUY5WFHYOGACYO7MNQYCQRQZPFPP4QPBA
SEP10_SERVER_ACCOUNT_ID=GBXOM54XRJJR553XWU62DPYHGJREBC6F4IVYFI3C77GC5FZV2PBEYCHA
SEP10_HOME_DOMAIN=localhost
SEP10_WEB_AUTH_DOMAIN=localhost
SEP10_JWT_DURATION=24h

# ─── x402 — Stellar testnet defaults ────────────────────
X402_NETWORK=stellar:testnet
X402_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
X402_USDC_CONTRACT=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
X402_USDC_CODE=USDC

# DRY-RUN mode skips all calls to the OpenZeppelin facilitator and uses
# stub payment payloads. The backend extracts the payer address from the
# payload's `from` field and logs the call. Useful for offline development
# and for evaluators who don't want to spend real USDC.
#
# Set to `false` only when you have a real X402_TREASURY_SECRET and a real
# X402_FACILITATOR_API_KEY configured below, AND you want real settlement
# on testnet.
X402_DRY_RUN=true

# ─── x402 — production-only fields ──────────────────────
# Leave these EMPTY in dry-run mode. The backend boots with warnings about
# disabled features (sponsor endpoint returns 503, facilitator skipped) but
# everything else works.
#
# When going live:
#   X402_TREASURY_ADDRESS    The G-address that receives x402 payments
#   X402_TREASURY_SECRET     The S-key of the same wallet (signs sponsoring
#                            + USDC payments to demo wallets)
#   X402_FACILITATOR_API_KEY From OpenZeppelin's free /gen endpoint
#                            (curl https://channels.openzeppelin.com/gen)

X402_TREASURY_ADDRESS=
X402_TREASURY_SECRET=
X402_FACILITATOR_API_KEY=
X402_FACILITATOR_URL=https://channels.openzeppelin.com/x402

# ─── StellarFlow example: Apify + OpenAI ──────────────────
# Optional — if both are set, the sentiment endpoint runs REAL analysis
# (scrape with Apify + analyze with OpenAI). If either is empty, the
# handler falls back to a deterministic mock so the example still works
# offline and in dry-run mode.
#
# Get API keys:
#   Apify:  https://console.apify.com/account/integrations  (free tier available)
#   OpenAI: https://platform.openai.com/api-keys
APIFY_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ─── Sentry (optional) ──────────────────────────────────
# Leave empty unless you want crash reporting in production.
SENTRY_DSN=
