.env
.env.local
.env.*.local
.agent-testnet.json
backend/.env
frontend/.env
agent/.env
*.pem
*.key

# ─── Go services (backend + agent) ──────────────────────
# Compiled binaries
backend/api
backend/main
backend/bin/
agent/bin/
agent/agent
*.exe
*.test
*.out

# User-uploaded content
backend/uploads/

# go.work.sum is a local cache; go.work itself is committed
# so the monorepo workspace is shared across machines.
go.work.sum

